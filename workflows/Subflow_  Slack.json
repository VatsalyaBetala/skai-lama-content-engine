      "id": "11cbfc36-8f97-47ae-9fbe-4c217204cc6a",
      "name": "Slack: Fetch Collector Prompt",
      "credentials": {
        "notionApi": {
          "id": "bJLSXb7rDb4zr6O5",
          "name": "Notion - Vatsalya"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const blocks = $('Slack: Fetch Collector Prompt').first().json.results || [];\nconst config = $('Config: Slack Subflow').first().json;\n\n// Extract Collector Base Prompt\nlet collectorPrompt = '';\nlet inCollectorSection = false;\n\nfor (const block of blocks) {\n  if (block.type === 'heading_2') {\n    const text = block.heading_2?.rich_text?.[0]?.plain_text || '';\n    if (text.includes('Collector Base Prompt')) {\n      inCollectorSection = true;\n      continue;\n    }\n    if (inCollectorSection) break;\n  }\n  if (inCollectorSection && block.type === 'code') {\n    collectorPrompt = block.code?.rich_text?.map(r => r.plain_text).join('') || '';\n    break;\n  }\n}\n\nif (!collectorPrompt) {\n  collectorPrompt = 'ERROR: Collector Base Prompt not found in Prompt Library';\n}\n\n// Channel order matches the Merge node input order (0-6)\nconst channelOrder = [\n  { id: config.chKite, name: '#kite' },\n  { id: config.chEasyBundles, name: '#easy-bundles' },\n  { id: config.chNewReview, name: '#new-review' },\n  { id: config.chKiteCxOps, name: '#kite-cx-ops' },\n  { id: config.chEbCxOps, name: '#eb-cx-ops' },\n  { id: config.chCheckoutwiz, name: '#checkoutwiz' },\n  { id: config.chFlybundles, name: '#flybundles' },\n];\n\nconst allItems = $('Slack: Merge Channels').all();\nlet formattedData = '';\n\nconst IGNORE = [\n  /joined the channel/i,\n  /left the channel/i,\n  /standup/i,\n  /set the channel/i,\n  /has joined/i\n];\n\nfor (let i = 0; i < allItems.length; i++) {\n  const item = allItems[i];\n  const channel = channelOrder[i] || { id: 'unknown', name: `#channel-${i}` };\n  const channelUrl = `https://giftkart.slack.com/archives/${channel.id}`;\n  const messages = item.json.messages || [];\n\n  const filtered = messages\n    .filter(m => m.text && m.text.length > 20)\n    .filter(m => !IGNORE.some(p => p.test(m.text)))\n    .slice(0, 15);\n\n  if (filtered.length > 0) {\n    formattedData += `\\n\\n=== ${channel.name} ===`;\n    formattedData += `\\nChannel URL: ${channelUrl}`;\n    formattedData += `\\nDate range: ${config.dateLastMonday} to ${config.dateToday}\\n`;\n\n    for (const msg of filtered) {\n      const text = msg.text.replace(/<[^>]+>/g, '').substring(0, 300);\n      const ts = msg.ts\n        ? new Date(parseFloat(msg.ts) * 1000).toISOString().split('T')[0]\n        : config.dateToday;\n      const msgUrl = channelUrl;\n\n      formattedData += `\\n[${ts}] ${text}\\nURL: ${msgUrl}\\n`;\n    }\n  }\n}\n\nconst finalPrompt = collectorPrompt\n  .replace('[raw source data injected here]', formattedData || 'No messages this week.')\n  .replace('[source_name]', 'slack');\n\nreturn [{\n  json: {\n    userMessage: finalPrompt,\n    rawDataLength: formattedData.length,\n    dateToday: config.dateToday,\n    dateLastMonday: config.dateLastMonday\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
