    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text || '';\nconst config = $('Config: Slack Subflow').first().json;\n\n// Strip markdown backticks\nconst clean = raw\n  .replace(/^```json\\n?/, '')\n  .replace(/\\n?```$/, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n} catch(e) {\n  parsed = {\n    source: 'slack',\n    signals: [],\n    itemCount: 0,\n    dateRange: `${config.dateLastMonday} to ${config.dateToday}`,\n    status: 'error',\n    error: e.message\n  };\n}\n\n// Ensure required fields exist\nconst output = {\n  source: parsed.source || 'slack',\n  signals: parsed.signals || [],\n  itemCount: parsed.itemCount || parsed.signals?.length || 0,\n  dateRange: parsed.dateRange || `${config.dateLastMonday} to ${config.dateToday}`,\n  status: parsed.status || (parsed.signals?.length > 0 ? 'success' : 'empty')\n};\n\nconsole.log(`Slack collector: ${output.signals.length} signals extracted`);\nconsole.log(`High confidence: ${output.signals.filter(s => s.confidence === 'high').length}`);\nconsole.log(`Medium confidence: ${output.signals.filter(s => s.confidence === 'medium').length}`);\n\nreturn [{ json: output }];"
      },
      "type": "n8n-nodes-base.code",
