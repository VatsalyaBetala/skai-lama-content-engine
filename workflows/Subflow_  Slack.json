      "id": "847b3cf5-c585-40ec-9484-dc73ad465440",
      "name": "Slack: Claude Collector",
      "credentials": {
        "httpHeaderAuth": {
          "id": "feoW1VBDikCNaQ3D",
          "name": "Anthropic API"
        }
      }
