    {
      "parameters": {
        "jsCode": "const config = $input.first().json;\nconst repos = config.repos || ['skailama/kite-product-docs'];\n\nreturn repos.map(repo => ({\n  json: {\n    ...config,\n    repo\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
