      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        656,
        96
      ],
      "id": "179be45e-99cd-424d-9723-7b50eb5a9807",
      "name": "GH: Fetch PRs",
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "z3abkfYI6p1HBvep",
          "name": "GitHub API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst config = $('Config: GitHub Subflow').first().json;\nconst since = new Date(config.since);\n\nlet allPRs = [];\n\nfor (const item of items) {\n  const repo = item.json._repo || config.repos?.[0] || 'skailama/kite-product-docs';\n  const prs = Array.isArray(item.json) ? item.json : [];\n\n  const merged = prs.filter(pr => {\n    if (!pr.merged_at) return false;\n    const mergedDate = new Date(pr.merged_at);\n    return mergedDate >= since;\n  });\n\n  console.log(`Repo ${repo}: ${prs.length} closed PRs, ${merged.length} merged since ${config.since}`);\n\n  for (const pr of merged) {\n    allPRs.push({\n      repo,\n      number: pr.number,\n      title: pr.title || '',\n      body: (pr.body || '').trim().substring(0, 1500),\n      labels: (pr.labels || []).map(l => l.name),\n      mergedAt: pr.merged_at,\n      url: pr.html_url,\n      author: pr.user?.login || '',\n      additions: pr.additions || 0,\n      deletions: pr.deletions || 0\n    });\n  }\n}\n\nconsole.log(`Total merged PRs this week: ${allPRs.length}`);\n\nreturn [{ json: { allPRs, prCount: allPRs.length } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        96
      ],
      "id": "f3b7d4ad-ad76-41f5-a748-3937fe6cb995",
      "name": "GH: Filter Merged PRs"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst config = $('Config: GitHub Subflow').first().json;\nconst prs = data.allPRs || [];\n\nlet collated = '=== GitHub PR Signals ===\\n';\ncollated += `Period: ${config.dateLastMonday} to ${config.dateToday}\\n`;\ncollated += `Total merged PRs: ${prs.length}\\n\\n`;\n\nfor (const pr of prs) {\n  collated += `=== PR #${pr.number}: ${pr.title} ===\\n`;\n  collated += `Repo: ${pr.repo}\\n`;\n  collated += `Merged: ${pr.mergedAt?.split('T')[0]}\\n`;\n  collated += `Author: ${pr.author}\\n`;\n  if (pr.labels.length > 0) {\n    collated += `Labels: ${pr.labels.join(', ')}\\n`;\n  }\n  collated += `URL: ${pr.url}\\n`;\n  if (pr.body && pr.body.length > 0) {\n    collated += `\\nDescription:\\n${pr.body}\\n`;\n  }\n  collated += '\\n---\\n\\n';\n}\n\nif (prs.length === 0) {\n  collated += 'No merged PRs found this week.\\n';\n}\n\nreturn [{\n  json: {\n    githubContent: collated,\n    prCount: prs.length,\n    dateToday: config.dateToday,\n    dateLastMonday: config.dateLastMonday\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        96
      ],
      "id": "767cfd16-3ec9-4433-b539-3fea6d04275e",
      "name": "GH: Collate PR Content"
    },
    {
      "parameters": {
        "url": "https://api.notion.com/v1/blocks/3667013d07a48168b948d0fee1677a4e/children?page_size=100",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1328,
        96
      ],
      "id": "d4186ec0-75a2-4b67-a873-aa20950add20",
      "name": "GH: Fetch Collector Prompt",
      "credentials": {
        "notionApi": {
          "id": "bJLSXb7rDb4zr6O5",
          "name": "Notion - Vatsalya"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const blocks = $('GH: Fetch Collector Prompt').first().json.results || [];\nconst collated = $('GH: Collate PR Content').first().json;\n\nlet collectorPrompt = '';\nlet inCollectorSection = false;\n\nfor (const block of blocks) {\n  if (block.type === 'heading_2') {\n    const text = block.heading_2?.rich_text?.[0]?.plain_text || '';\n    if (text.includes('GitHub Collector Prompt')) {\n      inCollectorSection = true;\n      continue;\n    }\n    if (inCollectorSection) break; // ← moved OUTSIDE the heading_2 check\n  }\n  if (inCollectorSection && block.type === 'code') {\n    collectorPrompt = block.code?.rich_text?.map(r => r.plain_text).join('') || '';\n    break;\n  }\n}\n\nif (!collectorPrompt) {\n  collectorPrompt = 'ERROR: GitHub Collector Prompt not found in Prompt Library';\n}\n\nconst finalPrompt = collectorPrompt\n  .replace('[raw source data injected here]', collated.githubContent || 'No GitHub PR data found.')\n  .replace('[source_name]', 'github');\n\nreturn [{\n  json: {\n    userMessage: finalPrompt,\n    prCount: collated.prCount,\n    dateToday: collated.dateToday,\n    dateLastMonday: collated.dateLastMonday\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
