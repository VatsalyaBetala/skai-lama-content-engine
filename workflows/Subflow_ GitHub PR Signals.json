        432,
        96
      ],
      "id": "be2474c9-63f9-4235-a4db-a7c7bf3acea4",
      "name": "GH: Split Repos"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.repo }}/pulls",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
