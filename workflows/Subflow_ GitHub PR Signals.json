      ],
      "id": "159b9b33-2127-4a21-b920-57d54aeeae19",
      "name": "GH: Claude Collector",
      "credentials": {
        "httpHeaderAuth": {
          "id": "feoW1VBDikCNaQ3D",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst context = $('GH: Build Collector Context').first().json;\n\nconst raw = response.content?.[0]?.text || '';\n\nconst clean = raw\n  .replace(/^```json\\n?/, '')\n  .replace(/\\n?```$/, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n} catch(e) {\n  console.log('Parse error:', e.message);\n  parsed = {\n    source: 'github',\n    signals: [],\n    itemCount: 0,\n    dateRange: `${context.dateLastMonday} to ${context.dateToday}`,\n    status: 'error',\n    error: e.message,\n    rawOutput: raw.substring(0, 500)\n  };\n}\n\nconst signals = parsed.signals || [];\nconsole.log(`GitHub collector: ${signals.length} signals extracted from ${context.prCount} PRs`);\n\nreturn [{\n  json: {\n    source: 'github',\n    signals,\n    itemCount: signals.length,\n    prCount: context.prCount,\n    dateRange: `${context.dateLastMonday} to ${context.dateToday}`,\n    status: parsed.status || 'success'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
