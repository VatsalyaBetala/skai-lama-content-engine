    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst blocks = response.results || [];\n\nconst pageTitle = $('Notion: Loop Over Pages').first().json.title;\nconst pageType = $('Notion: Loop Over Pages').first().json.type;\nconst pageApp = $('Notion: Loop Over Pages').first().json.app;\nconst lastEdited = $('Notion: Loop Over Pages').first().json.lastEdited;\nconst pageId = $('Notion: Loop Over Pages').first().json.id;\nconst pageUrl = $('Notion: Loop Over Pages').first().json.url || '';\n\nlet text = '';\nconst toggleIds = [];\n\nfor (const block of blocks) {\n  const type = block.type;\n  const content = block[type];\n  if (!content) continue;\n\n  const richText = content.rich_text || [];\n  const blockText = richText.map(r => r.plain_text).join('');\n\n  if (type === 'toggle' && block.has_children) {\n    // Collect toggle header text + flag for child fetching\n    if (blockText.trim()) text += `\\n## ${blockText}\\n`;\n    toggleIds.push(block.id);\n    continue;\n  }\n\n  if (!blockText.trim()) continue;\n\n  if (type === 'heading_1') text += `\\n# ${blockText}\\n`;\n  else if (type === 'heading_2') text += `\\n## ${blockText}\\n`;\n  else if (type === 'heading_3') text += `\\n### ${blockText}\\n`;\n  else if (type === 'bulleted_list_item') text += `- ${blockText}\\n`;\n  else if (type === 'numbered_list_item') text += `- ${blockText}\\n`;\n  else if (type === 'paragraph') text += `${blockText}\\n`;\n  else if (type === 'callout') text += `> ${blockText}\\n`;\n  else if (type === 'quote') text += `\"${blockText}\"\\n`;\n  else if (type === 'synced_block') text += `[synced content]\\n`;\n}\n\nconst cleanText = text.replace(/\\n{3,}/g, '\\n\\n').trim();\nconst truncated = cleanText.length > 4000\n  ? cleanText.substring(0, 4000) + '\\n[truncated...]'\n  : cleanText;\n\nreturn [{\n  json: {\n    pageId,\n    pageTitle,\n    pageType,\n    pageApp,\n    lastEdited,\n    pageUrl,\n    content: truncated,\n    toggleIds,\n    hasToggles: toggleIds.length > 0,\n    charCount: cleanText.length\n  }\n}];"
      },
