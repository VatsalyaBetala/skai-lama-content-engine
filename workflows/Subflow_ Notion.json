    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nlet rawContext = '';\nlet allPages = [];\n\nfor (const item of allItems) {\n  const results = item.json.results || [];\n  \n  for (const page of results) {\n    const title = page.properties?.Name?.title?.[0]?.plain_text\n      || page.properties?.title?.title?.[0]?.plain_text\n      || 'Untitled';\n    \n    const type = page.properties?.Type?.select?.name\n      || page.properties?.['Document Type']?.select?.name\n      || '';\n    \n    const app = page.properties?.App?.select?.name || '';\n    const pillar = page.properties?.Pillar?.select?.name || '';\n    const status = page.properties?.Status?.select?.name || '';\n    const initiativeStatus = page.properties?.['Initiative Status']?.select?.name || '';\n    const owner = page.properties?.Owner?.people?.[0]?.name || '';\n    const lastEdited = page.last_edited_time?.substring(0, 10) || '';\n\n    // Skip archived\n    if (status === 'Archived') continue;\n\n    rawContext += `- \"${title}\"`;\n    if (app) rawContext += ` [${app}]`;\n    if (type) rawContext += ` | ${type}`;\n    if (pillar) rawContext += ` | ${pillar}`;\n    if (status) rawContext += ` | ${status}`;\n    if (initiativeStatus) rawContext += ` | Initiative: ${initiativeStatus}`;\n    if (owner) rawContext += ` | Owner: ${owner}`;\n    if (lastEdited) rawContext += ` | Edited: ${lastEdited}`;\n    rawContext += '\\n';\n\n    allPages.push({\n      id: page.id,\n      title,\n      type,\n      app,\n      pillar,\n      status,\n      owner,\n      lastEdited,\n      url: page.url\n    });\n  }\n}\n\n// Deduplicate by ID\nconst seen = new Set();\nallPages = allPages.filter(p => {\n  if (seen.has(p.id)) return false;\n  seen.add(p.id);\n  return true;\n});\n\nreturn [{\n  json: {\n    rawNotionData: rawContext || 'No Notion pages found.',\n    pages: allPages,\n    totalPages: allPages.length\n  }\n}];"
      },
