    {
      "parameters": {
        "jsCode": "const blocks = $('Notion: Fetch Collector Prompt').first().json.results || [];\nconst collated = $('Notion: Collate Content').first().json;\nconst config = $('Config: Notion Subflow').first().json;\n\nconst notionContent = collated.notionFullContent || 'No Notion content found.';\nconst dateToday = collated.dateToday || config.dateToday || '';\nconst dateLastMonday = collated.dateLastMonday || config.dateLastMonday || '';\n\n// Extract Collector Base Prompt\nlet collectorPrompt = '';\nlet inCollectorSection = false;\n\nfor (const block of blocks) {\n  if (block.type === 'heading_2') {\n    const text = block.heading_2?.rich_text?.[0]?.plain_text || '';\n    if (text.includes('Collector Base Prompt')) {\n      inCollectorSection = true;\n      continue;\n    }\n    if (inCollectorSection) break;\n  }\n  if (inCollectorSection && block.type === 'code') {\n    collectorPrompt = block.code?.rich_text?.map(r => r.plain_text).join('') || '';\n    break;\n  }\n}\n\nif (!collectorPrompt) {\n  collectorPrompt = 'ERROR: Collector Base Prompt not found in Prompt Library';\n}\n\nconst urlNote = '\\n\\nIMPORTANT: Each document section starts with \"Source URL:\". You MUST include this URL in the origin.url field for every signal extracted from that document. Never leave origin.url as null if a Source URL is present.\\n\\n';\n\nconst finalPrompt = collectorPrompt\n  .replace('[raw source data injected here]', urlNote + (collated.notionFullContent || 'No Notion content found.'))\n  .replace('[source_name]', 'notion');\n\nreturn [{\n  json: {\n    userMessage: finalPrompt,\n    totalPages: collated.totalPages || 0,\n    dateToday: config.dateToday,\n    dateLastMonday: config.dateLastMonday\n  }\n}];"
      },
