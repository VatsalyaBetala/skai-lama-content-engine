      "name": "Notion: Claude Collector",
      "credentials": {
        "httpHeaderAuth": {
          "id": "feoW1VBDikCNaQ3D",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst raw = response.content?.[0]?.text || '';\nconst context = $('Notion: Build Collector Context').first().json;\n\nconst clean = raw\n  .replace(/^```json\\n?/, '')\n  .replace(/\\n?```$/, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(clean);\n} catch(e) {\n  parsed = {\n    source: 'notion',\n    signals: [],\n    itemCount: 0,\n    dateRange: `${context.dateLastMonday} to ${context.dateToday}`,\n    status: 'error',\n    error: e.message\n  };\n}\n\nconst output = {\n  source: parsed.source || 'notion',\n  signals: parsed.signals || [],\n  itemCount: parsed.itemCount || parsed.signals?.length || 0,\n  dateRange: parsed.dateRange || `${context.dateLastMonday} to ${context.dateToday}`,\n  status: parsed.status || (parsed.signals?.length > 0 ? 'success' : 'empty')\n};\n\nconsole.log(`Notion collector: ${output.signals.length} signals extracted`);\nconsole.log(`High: ${output.signals.filter(s => s.confidence === 'high').length}`);\nconsole.log(`Medium: ${output.signals.filter(s => s.confidence === 'medium').length}`);\n\nreturn [{ json: output }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
