    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet collated = '=== Notion Page Content ===\\n';\nlet pageCount = 0;\n\nfor (const item of items) {\n  const title = item.json.pageTitle || '';\n  const type = item.json.pageType || '';\n  const app = item.json.pageApp || '';\n  const edited = item.json.lastEdited || '';\n  const content = item.json.content || '';\n  const url = item.json.pageUrl || '';\n\n  if (!content || content === 'No pages found.') continue;\n\n  collated += `\\n--- ${title} [${app}] (${type}) — edited ${edited} ---`;\n  collated += `\\nSource URL: ${url || 'Not available'}`;\n  collated += `\\n${content}\\n`;\n  pageCount++;\n}\n\nif (pageCount === 0) {\n  collated = '=== Notion Page Content ===\\nNo relevant pages found this week.';\n}\n\nreturn [{\n  json: {\n    notionFullContent: collated,\n    totalPages: pageCount\n  }\n}];"
      },
